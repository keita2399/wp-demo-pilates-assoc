{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "ピラティス指導者協会（架空）WordPress試作",
		"description": "料金の一元管理、目的別の3つの導線、認定スタジオ検索、旧URLの転送表、事務局の権限。外部プラグインなし。データはすべて架空。",
		"author": "keita2399"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "ja"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/keita2399/wp-demo-pilates-assoc/main/pilates-assoc-demo.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; phi_demo_seed();"
		}
	]
}
